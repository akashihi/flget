TabbedContent {
    height: 50%
}
TabbedContent ContentSwitcher, DataTable {
    height: 1fr
}

SaveScreen {
    align: center middle;
}

#save-dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 12;
    border: thick $background 80%;
    background: $surface;
}

#save-question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

#save-input {
    column-span: 2;
    height: 1fr;
    width: 1fr;
}

SaveScreen Button {
    width: 1fr;
}