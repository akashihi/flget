#search-bar {
    height: auto;
}

#search-input {
    width: 1fr;
}

#filter-books {
    width: auto;
}

TabbedContent {
    height: 50%
}
TabbedContent ContentSwitcher, DataTable {
    height: 1fr
}

SaveScreen {
    align: center middle;
}

#save-dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 12;
    border: thick $background 80%;
    background: $surface;
}

#save-question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

#save-input {
    column-span: 2;
    height: 1fr;
    width: 1fr;
}

SaveScreen Button {
    width: 1fr;
}

FilterScreen {
    align: center middle;
}

#filter-dialog {
    grid-size: 1;
    grid-rows: 1 1fr 3 3;
    grid-gutter: 1;
    padding: 0 1;
    width: 90%;
    height: 90%;
    border: thick $background 80%;
    background: $surface;
}

#filter-title {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
}

#filter-lists {
    height: 1fr;
}

.filter-col {
    width: 1fr;
    height: 1fr;
}

.filter-col SelectionList {
    height: 1fr;
    border: round $primary;
}

#filter-ranges {
    height: auto;
    align: left middle;
}

.filter-range-label {
    width: auto;
    padding: 1 1 0 2;
}

#filter-ranges Input {
    width: 1fr;
}

#filter-buttons {
    height: auto;
    align: center middle;
}

#filter-buttons Button {
    width: 1fr;
    margin: 0 1;
}
